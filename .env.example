# Copy this file to .env.local and fill in values. Never commit .env.local.

# Which score feed the app uses. "mock" = built-in fake games (free, no key needed).
DATA_PROVIDER=mock

# Phase B: reading slip screenshots. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional: require this passcode before reading slips (stops strangers spending your credit).
SLIP_READER_PASSCODE=

# Added in later phases:
# NEXT_PUBLIC_SUPABASE_URL=   # Phase C: accounts + saved slips
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# CFBD_API_KEY=               # Phase D: CollegeFootballData.com
